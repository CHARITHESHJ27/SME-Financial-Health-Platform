# ─────────────────────────────────────────────────────────────
#  Finexri — Environment Variables Template
#  Copy this file to backend/.env and fill in real values.
#  NEVER commit backend/.env to version control.
# ─────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# AI Providers (at least one recommended)
OPENAI_API_KEY=<your-openai-api-key>        # https://platform.openai.com
GROQ_API_KEY=<your-groq-api-key>            # https://console.groq.com (free tier)

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<minimum-64-char-random-hex-string>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application
ENVIRONMENT=development                     # change to: production
SECRET_KEY=<random-secret-key>
DEBUG=False

# CORS — set to your production frontend domain
FRONTEND_URL=http://localhost:3000

# Security
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=./uploads

# Logging
LOG_LEVEL=INFO

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# External APIs (future integrations)
BANKING_API_KEY=<your-banking-api-key>
GST_API_KEY=<your-gst-api-key>

# Email (optional notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email>
SMTP_PASSWORD=<your-app-password>
